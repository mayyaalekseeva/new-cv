---
// Landing page for the event QR code (maiia.work/hi): saving the contact comes first,
// everything else is one tap below. Kept out of search results; the homepage is the real site.
import BaseLayout from '../layouts/BaseLayout.astro';
import { profile } from '../data/cv';

const [user, domain] = profile.email.split('@');
const [cv] = profile.cv;
const vcf = '/maiia-alekseeva.vcf';

const arrow = 'M3.5 8.5l5-5M4.5 3.5h4v4';

const links = [
  {
    label: 'LinkedIn',
    hint: 'connect',
    href: profile.linkedin,
    icon: 'M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z',
  },
  {
    label: 'WhatsApp',
    hint: '@' + profile.whatsapp.split('/').pop(),
    href: profile.whatsapp,
    outline: true,
  },
];
---

<BaseLayout
  title="Maiia Alekseeva — nice to meet you"
  description="Save my contact, connect on LinkedIn or grab my CV."
  noindex
>
  <main class="mx-auto flex min-h-svh max-w-md flex-col px-4 pt-12 pb-10 sm:pt-20">
    <header class="reveal flex flex-col items-center text-center">
      <img
        src={profile.photo}
        alt={profile.name}
        width="640"
        height="640"
        class="size-32 rounded-full border-4 border-card object-cover shadow-[5px_5px_0_var(--color-pop)] sm:size-36"
      />
      <h1 class="mt-7 text-5xl leading-[0.95] font-semibold tracking-[-0.045em] sm:text-6xl">
        hi, i’m maiia<span class="text-accent">.</span>
      </h1>
      <p class="mt-4 text-lg leading-snug text-balance text-ink/80">
        {profile.title.toLowerCase()} in lisbon, building complex React apps people
        <span class="marker text-accent">actually enjoy</span> using.
      </p>
    </header>

    <a href={vcf} class="btn btn-primary reveal mt-9 justify-center py-4 text-base">
      <svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <circle cx="10" cy="8" r="4" />
        <path d="M3 20c.8-3.6 3.6-6 7-6 1.2 0 2.3.3 3.3.8M18 14v6M15 17h6" />
      </svg>
      Save my contact
    </a>
    <p class="reveal mt-3 text-center text-sm text-muted">name, email, links and photo, in one tap</p>

    <ul class="reveal mt-9 overflow-hidden rounded-3xl border border-line bg-card/70">
      {links.map((link) => (
        <li class="border-b border-line">
          <a href={link.href} target="_blank" rel="noopener noreferrer" class="group flex items-center gap-4 px-5 py-4 transition hover:bg-surface">
            <span class="inline-flex size-10 shrink-0 items-center justify-center rounded-full bg-surface text-ink transition group-hover:-rotate-6 group-hover:bg-card">
              {link.outline ? (
                <svg class="size-[18px]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                  {/* Speech bubble with a tail: reads as "chat" without the brand logo */}
                  <path stroke-linejoin="round" d="M12 3a9 9 0 0 0-7.8 13.5L3 21l4.6-1.2A9 9 0 1 0 12 3z" />
                </svg>
              ) : (
                <svg class="size-[18px]" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d={link.icon} /></svg>
              )}
            </span>
            <span class="flex-1">
              <span class="block font-medium">{link.label}</span>
              <span class="text-sm text-muted">{link.hint}</span>
            </span>
            <svg class="size-3 text-muted transition group-hover:text-accent" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true"><path d={arrow} /></svg>
          </a>
        </li>
      ))}
      <li class="border-b border-line">
        {/* Same trick as CopyEmail: the address is put together by the script, never written whole in the HTML */}
        <a data-email data-user={user} data-domain={domain} class="group flex items-center gap-4 px-5 py-4 transition hover:bg-surface">
          <span class="inline-flex size-10 shrink-0 items-center justify-center rounded-full bg-surface text-ink transition group-hover:-rotate-6 group-hover:bg-card">
            <svg class="size-[18px]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <rect x="3" y="5" width="18" height="14" rx="3" />
              <path d="M4 7l8 6 8-6" />
            </svg>
          </span>
          <span class="flex-1">
            <span class="block font-medium">Email</span>
            <span class="text-sm break-all text-muted">{user}<span class="email-at"></span>{domain}</span>
          </span>
          <svg class="size-3 text-muted transition group-hover:text-accent" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true"><path d={arrow} /></svg>
        </a>
      </li>
      <li>
        <a href={cv.href} download class="group flex items-center gap-4 px-5 py-4 transition hover:bg-surface">
          <span class="inline-flex size-10 shrink-0 items-center justify-center rounded-full bg-surface text-ink transition group-hover:-rotate-6 group-hover:bg-card">
            <svg class="size-[18px]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8z" />
              <path d="M14 3v5h5M12 11v6M9 14l3 3 3-3" />
            </svg>
          </span>
          <span class="flex-1">
            <span class="block font-medium">CV</span>
            <span class="text-sm text-muted">English, PDF</span>
          </span>
          <svg class="size-3 text-muted transition group-hover:text-accent" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true"><path d="M6 2v7M3 6.5l3 3 3-3" /></svg>
        </a>
      </li>
    </ul>

    <a href="/" class="reveal group mt-auto inline-flex items-center justify-center gap-2 pt-10 text-sm text-muted transition hover:text-ink">
      see my work and case studies
      <span class="transition group-hover:translate-x-1" aria-hidden="true">→</span>
    </a>
  </main>
</BaseLayout>

<script>
  document.querySelectorAll<HTMLAnchorElement>('[data-email]').forEach((link) => {
    link.href = `mailto:${link.dataset.user}@${link.dataset.domain}`;
  });
</script>
