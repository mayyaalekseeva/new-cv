---
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/Nav.astro';
import CvMenu from '../components/CvMenu.astro';
import SocialLinks from '../components/SocialLinks.astro';
import CopyEmail from '../components/CopyEmail.astro';
import { profile, experience, stats, coffee, projects, skills, beyondCode, education, languages } from '../data/cv';
import { formatMonths, monthsIn, totalMonths } from '../lib/duration';

const [featured] = projects;
const [degree, ...courses] = education;
---

<BaseLayout>
  <Nav />

  <main class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
    <header id="top" class="pt-32 pb-14 sm:pt-40 sm:pb-20">
      <div class="reveal mb-8 flex flex-wrap items-center gap-x-4 gap-y-2 text-sm text-muted">
        {profile.openToWork && (
          <p class="inline-flex items-center gap-2 rounded-full border border-line px-3 py-1">
            <span class="relative flex size-2">
              <span class="absolute inline-flex size-full animate-ping rounded-full bg-pop"></span>
              <span class="relative inline-flex size-2 rounded-full bg-pop"></span>
            </span>
            open to new roles
          </p>
        )}
        <p>{profile.location} · remote, European time zones</p>
      </div>

      <h1 class="reveal text-[clamp(3.75rem,14vw,10.5rem)] leading-[0.88] font-semibold tracking-[-0.055em]">
        hi, i’m maiia<span class="text-accent">.</span>
      </h1>

      <div class="mt-10 grid gap-8 lg:grid-cols-12 lg:items-end">
        <p class="reveal text-xl leading-snug text-balance text-ink/80 sm:text-2xl lg:col-span-7">
          product engineer with 5+ years of turning complex, data-heavy apps into interfaces people
          <span class="marker text-accent">actually enjoy</span> using.
        </p>
        <div class="reveal flex flex-wrap items-center gap-3 lg:col-span-5 lg:justify-end">
          <CvMenu />
          <CopyEmail variant="button" />
          <span class="flex">
            <SocialLinks />
          </span>
        </div>
      </div>
    </header>

    <section id="work" class="scroll-mt-24">
      <div class="reveal mb-8 flex flex-wrap items-end justify-between gap-x-8 gap-y-3">
        <h2 class="text-4xl font-semibold tracking-tight sm:text-6xl">
          where i’ve worked<span class="text-accent">.</span>
        </h2>
        <p class="text-muted sm:pb-2">
          <span class="text-2xl font-semibold tracking-tight text-ink tabular-nums sm:text-3xl" data-total-duration>
            {formatMonths(totalMonths(experience))}
          </span>
          in tech overall
        </p>
      </div>

      <div class="border-b border-line">
        {experience.map((job, i) => (
          <details class="row reveal group border-t border-line" open={i === 0}>
            <summary class="grid cursor-pointer list-none grid-cols-[1fr_auto] items-center gap-x-6 gap-y-1 py-6 [&::-webkit-details-marker]:hidden md:grid-cols-[11rem_1fr_auto] lg:grid-cols-[11rem_1fr_1fr_auto]">
              <span class="col-span-2 text-sm text-muted tabular-nums md:col-span-1">
                {job.period}
                <span class="block text-ink/80" data-duration data-start={job.start} data-end={job.end}>
                  {formatMonths(monthsIn(job))}
                </span>
              </span>
              <span>
                <span class="block text-2xl font-semibold tracking-tight transition group-hover:text-accent sm:text-3xl">{job.company}</span>
                <span class="text-sm text-muted">
                  {job.role}
                  {job.cases && <span class="text-accent"> · {job.cases.length} case studies</span>}
                </span>
              </span>
              <span class="hidden text-sm text-muted lg:block">{job.stack.join(' · ')}</span>
              <span class="inline-flex size-10 items-center justify-center rounded-full border border-line text-ink/70 transition duration-300 group-open:border-accent group-open:text-accent group-hover:border-accent" aria-hidden="true">
                <svg class="size-4 transition-transform duration-300 group-open:rotate-180" viewBox="0 0 16 16" fill="none">
                  <path d="M4 6l4 4 4-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
              </span>
            </summary>
            <div class="pb-8 md:pl-[calc(11rem+1.5rem)]">
              <ul class="max-w-2xl space-y-2.5 leading-relaxed text-ink/85">
                {job.points.map((point) => (
                  <li class="flex gap-3">
                    <span class="mt-[0.8em] h-px w-3 shrink-0 bg-accent" aria-hidden="true"></span>
                    <span>{point}</span>
                  </li>
                ))}
              </ul>
              <p class="mt-4 text-sm text-muted lg:hidden">{job.stack.join(' · ')}</p>

              {job.cases && (
                <div class="mt-8">
                  <p class="tile-label mb-4">case studies</p>
                  <div class="grid gap-3 sm:grid-cols-2">
                    {job.cases.map((item, n) => (
                      <article class="flex flex-col rounded-2xl border border-line bg-card/70 p-5 transition duration-300 hover:-translate-y-0.5 hover:border-ink/20">
                        <p class="text-xs text-accent tabular-nums">case {String(n + 1).padStart(2, '0')}</p>
                        <h3 class="mt-1 text-lg leading-snug font-semibold tracking-tight">{item.title}</h3>
                        <dl class="mt-4 space-y-3 text-sm leading-relaxed">
                          <div>
                            <dt class="text-muted">problem</dt>
                            <dd class="text-ink/85">{item.problem}</dd>
                          </div>
                          <div>
                            <dt class="text-muted">what i did</dt>
                            <dd class="text-ink/85">{item.did}</dd>
                          </div>
                          <div class="border-l-2 border-accent pl-3">
                            <dt class="text-muted">result</dt>
                            <dd class="font-medium text-ink">{item.result}</dd>
                          </div>
                        </dl>
                        <ul class="mt-auto flex flex-wrap gap-1.5 pt-5">
                          {item.stack.map((tech) => <li class="chip !px-2.5 !py-0.5 text-xs">{tech}</li>)}
                        </ul>
                      </article>
                    ))}
                  </div>
                </div>
              )}
            </div>
          </details>
        ))}
      </div>

      <a
        id="projects"
        href={featured.url}
        target="_blank"
        rel="noopener noreferrer"
        class="reveal tile group mt-10 flex min-h-[22rem] flex-col justify-between !border-feature !bg-feature text-on-feature hover:-translate-y-1"
      >
        <div class="flex items-start justify-between gap-4">
          <p class="inline-flex items-center gap-2 rounded-full bg-brand px-3 py-1 text-sm text-on-brand">
            <span class="size-1.5 rounded-full bg-on-brand/80" aria-hidden="true"></span>
            {featured.tag}
          </p>
          <span class="inline-flex size-11 shrink-0 items-center justify-center rounded-full bg-on-feature text-lg text-baby-600 transition duration-300 group-hover:rotate-45 group-hover:bg-brand group-hover:text-on-brand" aria-hidden="true">↗</span>
        </div>
        <div>
          <h3 class="text-4xl font-semibold tracking-tight sm:text-5xl">{featured.name}</h3>
          <p class="mt-4 max-w-xl leading-relaxed text-on-feature/90">{featured.description}</p>
          <ul class="mt-6 flex flex-wrap gap-2">
            {featured.stack.map((item) => <li class="rounded-full bg-on-feature/12 px-3 py-1 text-sm text-on-feature/90">{item}</li>)}
          </ul>
        </div>
      </a>
    </section>

    <section id="about" class="scroll-mt-24 pt-24 sm:pt-32">
      <h2 class="reveal mb-10 text-4xl font-semibold tracking-tight sm:text-6xl">
        more about me<span class="text-accent">.</span>
      </h2>

      <div class="grid gap-3 sm:gap-4 md:grid-cols-6 lg:grid-cols-12">
        <div class="reveal tile flex flex-col justify-between gap-6 md:col-span-3 lg:col-span-6">
          <p class="tile-label">based in</p>
          <div>
            <p class="text-3xl font-semibold tracking-tight">{profile.location}</p>
            <p class="mt-1 text-ink/80">the city i changed careers for</p>
            <p class="mt-3 text-sm text-muted">
              <time id="local-time" class="text-ink tabular-nums">--:--</time> local time · working in european time zones
            </p>
          </div>
        </div>

        <div class="reveal tile flex flex-col justify-between gap-6 md:col-span-3 lg:col-span-6">
          <p class="tile-label">in numbers</p>
          <dl class="grid grid-cols-3 gap-4">
            {stats.map((stat) => (
              <div class="flex flex-col gap-1">
                <dt class="order-last text-xs leading-snug text-muted sm:text-sm">{stat.label}</dt>
                <dd class="text-3xl font-semibold tracking-tight sm:text-4xl">{stat.value}</dd>
              </div>
            ))}
          </dl>
        </div>

        <div id="skills" class="reveal tile md:col-span-6 lg:col-span-7">
          <p class="tile-label mb-5">toolbox</p>
          <dl class="grid gap-5 sm:grid-cols-2">
            {skills.map((skill) => (
              <div>
                <dt class="mb-2 text-sm font-medium">{skill.group}</dt>
                <dd class="flex flex-wrap gap-1.5">
                  {skill.items.map((item) => <span class="chip">{item}</span>)}
                </dd>
              </div>
            ))}
          </dl>
          <div class="mt-6 border-t border-line pt-5">
            <p class="mb-2 text-sm">
              <span class="font-medium">{beyondCode.group}</span>
              <span class="text-muted"> · {beyondCode.note}</span>
            </p>
            <div class="flex flex-wrap gap-1.5">
              {beyondCode.items.map((item) => <span class="chip chip-tint">{item}</span>)}
            </div>
          </div>
        </div>

        <div class="reveal tile flex flex-col justify-between gap-8 md:col-span-6 lg:col-span-5">
          <div>
            <p class="tile-label mb-5">about me</p>
            <p class="text-lg leading-relaxed text-ink/85">
              I’ve always been more interested in building things than just talking about ideas. From running coffee
              businesses to developing software, I’ve learned to think beyond my own role — about the people, the
              product, and what makes it worth using. I’m curious by nature, particular about details, and happiest
              when I get to figure things out from scratch.
            </p>
          </div>
          <ul class="flex flex-wrap gap-x-6 gap-y-2 border-t border-line pt-5 text-sm">
            {languages.map((language) => (
              <li><span class="font-medium">{language.name}</span> <span class="text-muted">{language.level}</span></li>
            ))}
          </ul>
        </div>

        <div class="reveal tile grid gap-8 md:col-span-6 lg:col-span-12 lg:grid-cols-12">
          <div class="lg:col-span-8">
            <p class="tile-label mb-5">business mindset</p>
            <p class="text-2xl leading-snug font-semibold tracking-tight text-balance sm:text-3xl">
              a <span class="marker text-accent">management degree</span> and my own coffee businesses taught me to
              think about users, costs and goals, not only code.
            </p>
            <p class="mt-5 text-ink/80">
              <span class="font-medium text-ink">{degree.place}</span> · {degree.detail} · {degree.years}
            </p>
          </div>
          <div class="lg:col-span-4 lg:border-l lg:border-line lg:pl-8">
            <p class="tile-label mb-5">frontend training</p>
            <ul class="space-y-4">
              {courses.map((item) => (
                <li>
                  <p class="font-medium">{item.place}</p>
                  <p class="mt-1 text-sm text-muted">{item.detail} · {item.years}</p>
                </li>
              ))}
            </ul>
          </div>
        </div>
      </div>
    </section>

    <section id="coffee" class="scroll-mt-24 pt-24 sm:pt-32">
      <h2 class="reveal mb-10 text-4xl font-semibold tracking-tight sm:text-6xl">
        before code: specialty coffee<span class="text-accent">.</span>
      </h2>

      <div class="grid gap-3 sm:gap-4 lg:grid-cols-12">
        <div class="reveal tile flex flex-col gap-5 lg:col-span-5">
          <p class="text-lg leading-relaxed text-ink/85">
            Before tech, I spent <span class="marker font-medium text-accent">10+ years in specialty coffee</span>,
            from behind the bar to founding my own coffee shop and launching a roastery. Running a business taught me
            to think strategically: who it’s for, what it costs and how it pays off. Coffee taught me to obsess over the
            details people feel but rarely notice.
          </p>
          <p class="text-lg leading-relaxed text-ink/85">
            I’d dreamed of living in <span class="marker">Lisbon</span> for years, and switching to tech was how I
            made it happen.
          </p>
          <ul class="mt-3 space-y-4 border-t border-line pt-6">
            {coffee.roles.map((role) => (
              <li>
                <p class="font-medium">{role.title}</p>
                <p class="text-sm text-muted">{role.detail}</p>
              </li>
            ))}
          </ul>
        </div>

        <div class="grid gap-3 sm:gap-4 lg:col-span-7">
          {coffee.ventures.map((venture) => (
            <a
              href={venture.url}
              target="_blank"
              rel="noopener noreferrer"
              class="reveal tile group flex flex-col justify-between gap-10 hover:-translate-y-1 hover:border-ink/20"
            >
              <div class="flex items-start justify-between gap-4">
                <p class="text-sm text-accent">{venture.role}</p>
                <span class="inline-flex size-11 shrink-0 items-center justify-center rounded-full bg-surface text-lg text-ink transition duration-300 group-hover:rotate-45 group-hover:bg-brand group-hover:text-on-brand" aria-hidden="true">↗</span>
              </div>
              <div>
                <h3 class="text-3xl font-semibold tracking-tight sm:text-4xl">{venture.name}</h3>
                <p class="mt-3 max-w-xl leading-relaxed text-ink/80">{venture.description}</p>
                {venture.funFact && (
                  <p class="mt-5 inline-flex flex-wrap items-baseline gap-x-2 rounded-2xl bg-surface px-4 py-2.5 text-sm">
                    <span class="font-medium text-accent">fun fact</span>
                    <span class="text-ink/85">{venture.funFact}</span>
                  </p>
                )}
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>

    <section id="contact" class="scroll-mt-24 pt-24 pb-10 sm:pt-32">
      <div class="reveal tile !border-feature !bg-feature px-6 py-12 text-on-feature sm:px-12 sm:py-16">
        <p class="text-sm text-on-feature/85">got a role or a project in mind?</p>
        <h2 class="mt-3 text-5xl font-semibold tracking-tight sm:text-7xl">let’s talk<span class="text-feature-accent">.</span></h2>
        <div class="mt-8">
          <CopyEmail
            class="text-xl break-all text-feature-accent underline decoration-feature-accent/40 underline-offset-4 transition hover:decoration-feature-accent sm:text-3xl"
            hintClass="text-on-feature/85 decoration-on-feature/30 hover:decoration-on-feature"
          />
        </div>
        <div class="mt-10 flex flex-wrap items-center gap-3">
          <CvMenu up />
          <SocialLinks onFeature />
        </div>
      </div>
    </section>
  </main>

  <footer class="mx-auto flex max-w-6xl flex-wrap justify-between gap-2 px-4 pb-10 text-sm text-muted sm:px-6 lg:px-8">
    <p>© {new Date().getFullYear()} {profile.name}</p>
    <p>made with astro in lisbon</p>
  </footer>
</BaseLayout>

<script>
  import { formatMonths, monthsIn, totalMonths, type Period } from '../lib/duration';

  // The page is static, so refresh ongoing durations with today's date.
  const periods: Period[] = [];
  document.querySelectorAll<HTMLElement>('[data-duration]').forEach((el) => {
    const period = { start: el.dataset.start!, end: el.dataset.end };
    periods.push(period);
    el.textContent = formatMonths(monthsIn(period));
  });
  const totalEl = document.querySelector('[data-total-duration]');
  if (totalEl && periods.length) totalEl.textContent = formatMonths(totalMonths(periods));

  const timeEl = document.getElementById('local-time');
  if (timeEl) {
    const format = new Intl.DateTimeFormat('en-GB', { timeZone: 'Europe/Lisbon', hour: '2-digit', minute: '2-digit' });
    const tick = () => {
      const now = new Date();
      timeEl.textContent = format.format(now);
      timeEl.setAttribute('datetime', now.toISOString());
    };
    tick();
    setInterval(tick, 30_000);
  }
</script>
