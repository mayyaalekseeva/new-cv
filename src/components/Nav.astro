---
const links = [
  { id: 'work', label: 'work' },
  { id: 'about', label: 'about' },
  { id: 'coffee', label: 'coffee' },
  { id: 'contact', label: 'contact' },
];
---
<nav aria-label="Main" class="fixed inset-x-0 top-4 z-50 flex justify-center px-4">
  <div class="flex max-w-full items-center gap-0.5 rounded-full border border-ink/10 bg-paper/80 p-1 shadow-sm backdrop-blur-md">
    <a href="#top" class="shrink-0 rounded-full px-2 py-1.5 text-base font-semibold text-accent sm:px-3" aria-label="Back to top">m.</a>
    {links.map((link) => (
      <a
        href={`#${link.id}`}
        data-nav={link.id}
        class="shrink-0 rounded-full px-2 py-1.5 text-sm whitespace-nowrap text-ink/70 min-[400px]:px-2.5 sm:px-3 transition hover:bg-surface hover:text-ink data-active:bg-brand data-active:text-on-brand"
      >
        {link.label}
      </a>
    ))}
    <span class="mx-1 hidden h-4 w-px shrink-0 bg-line sm:block" aria-hidden="true"></span>
    {/* Lingering on it slowly reveals a label (until the visitor has used it once); a click dissolves into the new theme */}
    <button
      id="theme-toggle"
      type="button"
      aria-label="Dark theme"
      aria-pressed="false"
      class="group inline-flex h-8 shrink-0 cursor-pointer items-center rounded-full px-2 text-ink/70 transition-colors duration-300 hover:bg-surface hover:text-ink focus-visible:bg-surface focus-visible:text-ink"
    >
      <span class="relative size-4 shrink-0">
        <svg class="absolute inset-0 size-4 transition-transform duration-500 ease-[cubic-bezier(0.34,1.56,0.64,1)] group-hover:-rotate-[25deg] group-focus-visible:-rotate-[25deg] dark:hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z" />
        </svg>
        <svg class="absolute inset-0 hidden size-4 transition-transform duration-700 ease-[cubic-bezier(0.22,1,0.36,1)] group-hover:rotate-90 group-focus-visible:rotate-90 dark:block" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="12" cy="12" r="4" />
          <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" />
        </svg>
      </span>
      <span class="grid grid-cols-[0fr] transition-[grid-template-columns] duration-500 ease-[cubic-bezier(0.22,1,0.36,1)] group-hover:grid-cols-[1fr] group-hover:delay-700 group-focus-visible:grid-cols-[1fr] group-data-seen:hidden" aria-hidden="true">
        <span class="overflow-hidden whitespace-nowrap">
          <span class="block -translate-x-2 pr-1 pl-2 text-sm opacity-0 blur-[2px] transition duration-500 group-hover:translate-x-0 group-hover:opacity-100 group-hover:blur-none group-hover:delay-700 group-focus-visible:translate-x-0 group-focus-visible:opacity-100 group-focus-visible:blur-none">
            <span class="dark:hidden">switch to dark theme</span>
            <span class="hidden dark:inline">switch to light theme</span>
          </span>
        </span>
      </span>
    </button>
  </div>
</nav>

<script>
  const navLinks = document.querySelectorAll<HTMLAnchorElement>('[data-nav]');

  // Highlights the section crossing the middle of the viewport; the hero clears it.
  const navObserver = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (!entry.isIntersecting) return;
        navLinks.forEach((link) => link.toggleAttribute('data-active', link.dataset.nav === entry.target.id));
      });
    },
    { rootMargin: '-45% 0px -50% 0px' }
  );

  ['top', ...Array.from(navLinks, (link) => link.dataset.nav!)].forEach((id) => {
    const section = document.getElementById(id);
    if (section) navObserver.observe(section);
  });

  type Theme = 'light' | 'dark';

  const root = document.documentElement;
  const themeToggle = document.getElementById('theme-toggle');
  const themeColor = document.querySelector<HTMLMetaElement>('#theme-color');

  // localStorage can throw (private mode, blocked storage); the theme then just isn't remembered
  const savedTheme = () => {
    try {
      return localStorage.getItem('theme');
    } catch {
      return null;
    }
  };
  const saveTheme = (theme: Theme) => {
    try {
      localStorage.setItem('theme', theme);
    } catch {}
  };

  const applyTheme = (theme: Theme) => {
    root.dataset.theme = theme;
    themeToggle?.setAttribute('aria-pressed', String(theme === 'dark'));
    if (themeColor) themeColor.content = themeColor.dataset[theme] ?? themeColor.content;
  };

  applyTheme(root.dataset.theme === 'dark' ? 'dark' : 'light');

  // Visitors who already picked a theme know what the button does: no more label.
  const markSeen = () => themeToggle?.setAttribute('data-seen', '');
  if (savedTheme()) markSeen();

  // The new theme dissolves outward from the button (View Transitions); instant where unsupported.
  const revealTheme = (next: Theme) => {
    const reduceMotion = matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (!document.startViewTransition || reduceMotion || !themeToggle) {
      applyTheme(next);
      return;
    }
    const { left, top, width, height } = themeToggle.getBoundingClientRect();
    const x = left + width / 2;
    const y = top + height / 2;
    // A soft edge about a third of the screen wide; the radius adds it so the edge fully clears the far corner
    const distance = Math.hypot(Math.max(x, innerWidth - x), Math.max(y, innerHeight - y));
    const feather = Math.max(300, distance * 0.35);
    root.style.setProperty('--reveal-x', `${x}px`);
    root.style.setProperty('--reveal-y', `${y}px`);
    root.style.setProperty('--reveal-feather', `${feather}px`);
    const transition = document.startViewTransition(() => applyTheme(next));
    transition.ready.then(() => {
      root.animate(
        { '--reveal': ['0px', `${distance + feather}px`] },
        { duration: 1500, easing: 'cubic-bezier(0.65, 0, 0.35, 1)', fill: 'forwards', pseudoElement: '::view-transition-new(root)' }
      );
    });
  };

  themeToggle?.addEventListener('click', () => {
    const next: Theme = root.dataset.theme === 'dark' ? 'light' : 'dark';
    revealTheme(next);
    markSeen();
    saveTheme(next);
  });

  // Follow system changes until the visitor picks a theme themselves.
  matchMedia('(prefers-color-scheme: dark)').addEventListener('change', (e) => {
    if (!savedTheme()) applyTheme(e.matches ? 'dark' : 'light');
  });
</script>
